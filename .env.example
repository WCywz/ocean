# ============================================================
# Ocean Forecast System — Environment Variables
# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit it.
# ============================================================

# Database (required by scripts/)
DB_HOST=localhost
DB_PORT=3306
DB_USER=ocean_forecast
DB_PASSWORD=
DB_NAME=ocean_forecast

# Backend (required by Spring Boot)
# Copy ocean-server/src/main/resources/application.yml.example
# to application.yml and fill in secrets there.
