server:
  port: 8080

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/ocean_forecast?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false
    username: root
    password: your_db_password

  data:
    redis:
      host: localhost
      port: 6379
      password:
      database: 0
      timeout: 5s
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
    default-property-inclusion: non_null

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.ocean.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT配置
jwt:
  secret: your_jwt_secret
  expiration: 3600000

# 预报模型调用配置
forecast:
  data-dir: ../
  python:
    path: your_python_path
    script-dir: ../ocean-model

# SMS / 消息推送配置
sms:
  provider: mock  # mock | aliyun | serverchan
  aliyun:
    access-key-id:
    access-key-secret:
    sign-name:
    template-code:
  serverchan:
    send-key:

# Knife4j API文档配置
springdoc:
  swagger-ui:
    path: /doc.html

# 头像上传目录（Linux: /data/ocean/uploads/avatars/，Windows: D:/data/ocean/uploads/avatars/）
upload:
  avatar:
    dir: ./uploads/avatars/

# send-key 加密配置
credential:
  encrypt:
    secret: your_aes_encrypt_secret_key
